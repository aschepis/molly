{
  "server": {
    "bind": "127.0.0.1",
    "port": 9765
  },
  "labels": {
    "user": null,
    "host": null,
    "extra": {}
  },
  "links": {
    "grafana": "http://localhost:3030",
    "prometheus": "http://localhost:9090"
  },
  "mcp": {
    "prometheusURL": "http://localhost:9090",
    "mollyURL": "http://127.0.0.1:9765"
  },
  "export": {
    "prometheusDataDir": ""
  },
  "stack": {
    "retention": "2y",
    "composeDir": ""
  },
  "logLevel": "info",
  "collectors": {
    "process": {
      "enabled": true,
      "interval": 30
    },
    "system": {
      "enabled": true,
      "interval": 15,
      "bluetooth": true,
      "wifi": {
        "enabled": false,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 0
      }
    },
    "processes": {
      "enabled": true,
      "interval": 30,
      "topN": 25,
      "names": {
        "enabled": true,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 25
      },
      "agents": {
        "claude": [
          "claude"
        ],
        "codex": [
          "codex"
        ],
        "cursor": [
          "Cursor Helper",
          "cursor"
        ],
        "aider": [
          "aider"
        ],
        "copilot": [
          "copilot"
        ],
        "gemini": [
          "gemini"
        ],
        "ollama": [
          "ollama"
        ]
      }
    },
    "focus": {
      "enabled": true,
      "interval": 5,
      "idleThresholdSeconds": 300,
      "maxGapSeconds": 60,
      "apps": {
        "enabled": true,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 0
      }
    },
    "docker": {
      "enabled": true,
      "interval": 60,
      "stats": false,
      "path": "",
      "containers": {
        "enabled": true,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 0
      }
    },
    "meeting": {
      "enabled": true,
      "interval": 5
    },
    "input": {
      "enabled": false,
      "interval": 5
    },
    "clipboard": {
      "enabled": true,
      "interval": 2
    },
    "hardware": {
      "enabled": true,
      "interval": 30,
      "dockedMinExternalDisplays": 1,
      "devices": {
        "enabled": false,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 20
      }
    },
    "browser": {
      "enabled": true,
      "interval": 60,
      "browsers": [],
      "extraProfiles": [],
      "domains": {
        "enabled": false,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 50
      }
    },
    "messages": {
      "enabled": true,
      "interval": 60,
      "path": "~/Library/Messages/chat.db"
    },
    "notes": {
      "enabled": true,
      "interval": 120,
      "path": "~/Library/Group Containers/group.com.apple.notes/NoteStore.sqlite",
      "folders": {
        "enabled": false,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 50
      }
    },
    "knowledge": {
      "enabled": true,
      "interval": 60,
      "path": "~/Library/Application Support/Knowledge/knowledgeC.db",
      "apps": {
        "enabled": true,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 50
      }
    },
    "calendar": {
      "enabled": true,
      "interval": 300,
      "calendars": {
        "enabled": false,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 50
      }
    },
    "mail": {
      "enabled": false,
      "interval": 120
    },
    "git": {
      "enabled": true,
      "interval": 120,
      "roots": [
        "~/src"
      ],
      "maxDepth": 4,
      "rescanSeconds": 1800,
      "activeDays": 30,
      "skipDirs": [
        "node_modules",
        ".build",
        "vendor"
      ],
      "authorEmails": [],
      "repos": {
        "enabled": true,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 50
      },
      "branches": {
        "enabled": true,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 0
      }
    },
    "claude_code": {
      "enabled": true,
      "interval": 60,
      "projectsDir": "~/.claude/projects",
      "historyFile": "~/.claude/history.jsonl",
      "activeWindowSeconds": 300,
      "sessionGapSeconds": 1800,
      "pricing": {},
      "projects": {
        "enabled": true,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 30
      }
    },
    "cursor": {
      "enabled": true,
      "interval": 120,
      "databasePath": "~/.cursor/ai-tracking/ai-code-tracking.db"
    },
    "codex": {
      "enabled": true,
      "interval": 120,
      "sessionsDir": "~/.codex/sessions",
      "activeWindowSeconds": 300
    },
    "shell": {
      "enabled": true,
      "interval": 60,
      "shells": [
        "zsh",
        "bash",
        "fish"
      ],
      "zshHistory": "~/.zsh_history",
      "bashHistory": "~/.bash_history",
      "fishHistory": "~/.local/share/fish/fish_history",
      "commands": {
        "enabled": false,
        "mode": "allowlist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 50
      },
      "hosts": {
        "enabled": false,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 50
      }
    },
    "projects": {
      "enabled": true,
      "interval": 60,
      "activeWindowSeconds": 1800,
      "retentionSeconds": 86400,
      "projects": {
        "enabled": true,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 30
      }
    },
    "power": {
      "enabled": true,
      "interval": 300,
      "backfillSeconds": 86400
    },
    "builds": {
      "enabled": true,
      "interval": 15,
      "tools": {
        "swift": ["swift-frontend", "swift-build", "swiftc"],
        "clang": ["clang", "clang-*", "cc1"],
        "xcodebuild": ["xcodebuild"],
        "cargo": ["cargo", "rustc"],
        "go": ["go", "compile", "link"],
        "node": ["tsc", "esbuild", "webpack", "vite"],
        "gradle": ["gradle"],
        "make": ["make", "gmake", "ninja", "cmake"],
        "docker": ["docker-buildx", "buildkit"],
        "python": ["pytest"],
        "jest": ["jest"]
      },
      "xcode": true,
      "derivedDataPath": "~/Library/Developer/Xcode/DerivedData",
      "derivedDataSeconds": 1800
    },
    "tabs": {
      "enabled": false,
      "interval": 60,
      "browsers": ["safari", "chrome", "brave", "arc", "edge", "vivaldi"]
    },
    "media": {
      "enabled": false,
      "interval": 15,
      "apps": ["music", "spotify"],
      "tracks": {
        "enabled": false,
        "mode": "denylist",
        "patterns": [],
        "hash": true,
        "salt": "",
        "maxCardinality": 100
      }
    },
    "titles": {
      "enabled": false,
      "interval": 5,
      "titles": {
        "enabled": true,
        "mode": "denylist",
        "patterns": [],
        "hash": true,
        "salt": "",
        "maxCardinality": 100
      }
    },
    "events": {
      "enabled": true,
      "interval": 60,
      "activeWindowSeconds": 300,
      "token": "",
      "projects": {
        "enabled": true,
        "mode": "denylist",
        "patterns": [],
        "hash": false,
        "salt": "",
        "maxCardinality": 30
      }
    },
    "health": {
      "enabled": false,
      "interval": 60,
      "token": "",
      "maxAgeSeconds": 604800,
      "allowRemoteBind": false,
      "detailedInsights": false
    },
    "insights": {
      "enabled": false,
      "interval": 300,
      "dailyAtHour": 21,
      "weekly": true,
      "model": "claude-sonnet-5-5",
      "apiKey": "",
      "backend": "auto",
      "prometheusURL": "http://localhost:9090"
    }
  }
}
