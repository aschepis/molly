    {
      "type": "timeseries",
      "title": "Focus vs system usage log (hours per hour)",
      "description": "Large gaps mean Molly was off or knowledgeC counts background apps.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "sum(increase(molly_focus_seconds_total{user=~\"$user\",host=~\"$host\"}[1h])) / 3600",
          "legendFormat": "Molly focus"
