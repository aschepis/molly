    {
      "type": "state-timeline",
      "title": "Flow state (5 minute buckets)",
      "description": "flow: active 80%+ and at most 1.5 app switches/min; shallow: active 50%+; break: otherwise. Thresholds live in deploy/prometheus/rules/molly.yml.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "molly:flow_state:5m{user=~\"$user\",host=~\"$host\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "break",
                  "color": "#898781",
                  "index": 0
                },
                "1": {
                  "text": "shallow",
                  "color": "#fab219",
                  "index": 1
                },
                "2": {
                  "text": "flow",
                  "color": "#0ca30c",
                  "index": 2
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#898781",
                "value": null
