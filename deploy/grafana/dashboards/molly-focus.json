{
  "uid": "molly-focus",
  "title": "Molly / Focus",
  "description": "Where your attention went: apps, switches, idle time, meetings.",
  "tags": [
    "molly"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "name": "Meeting",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#eb6834",
        "expr": "molly_meeting_active{user=~\"$user\",host=~\"$host\"} == 1",
        "step": "15s",
        "titleFormat": "meeting",
        "textFormat": "mic or camera in use",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Claude session",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#8a5cd6",
        "expr": "increase(molly_claude_sessions_total{user=~\"$user\",host=~\"$host\"}[1m]) > 0",
        "step": "15s",
        "titleFormat": "Claude session",
        "textFormat": "new Claude Code session",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Locked",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#d6489a",
        "expr": "molly_screen_locked{user=~\"$user\",host=~\"$host\"} == 1",
        "step": "15s",
        "titleFormat": "locked",
        "textFormat": "screen locked",
        "tagKeys": "",
        "useValueForTime": false
      }
    ]
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "user",
        "label": "user",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "query": {
          "query": "label_values(molly_up, user)",
          "refId": "user"
        },
        "definition": "label_values(molly_up, user)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "query": {
          "query": "label_values(molly_up{user=~\"$user\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(molly_up{user=~\"$user\"}, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Focus time",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Focus time by app (selected range)",
      "description": "Frontmost time while active and unlocked.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "topk(15, sum by (app) (increase(molly_focus_seconds_total{user=~\"$user\",host=~\"$host\"}[$__range])))",
          "legendFormat": "{{app}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "min": 0,
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
