    {
      "type": "stat",
      "title": "Active vs idle (today)",
      "description": "Share of today the machine was awake, unlocked and not idle past the idle threshold.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "avg(avg_over_time(molly_user_active{user=~\"$user\",host=~\"$host\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "mappings": [],
          "decimals": 0,
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
