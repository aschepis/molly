{
  "uid": "molly-play",
  "title": "Molly / Play",
  "description": "Gaming against working time: sessions, games, controller use and GPU load.",
  "tags": [
    "molly"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "name": "Commits",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#2a78d6",
        "expr": "changes(molly_git_last_commit_timestamp_seconds{user=~\"$user\",host=~\"$host\"}[1m]) > 0",
        "step": "15s",
        "titleFormat": "commit",
        "textFormat": "{{repo}}",
        "tagKeys": "repo",
        "useValueForTime": false
      },
      {
        "name": "Meetings",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#eb6834",
        "expr": "molly_meeting_active{user=~\"$user\",host=~\"$host\"} == 1",
        "step": "15s",
        "titleFormat": "meeting",
        "textFormat": "mic or camera in use",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Screen locked",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#898781",
        "expr": "molly_screen_locked{user=~\"$user\",host=~\"$host\"} == 1",
        "step": "15s",
        "titleFormat": "locked",
        "textFormat": "screen locked",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Gaming",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#8e6bd6",
        "expr": "max by (user, host) (molly_gaming_active{user=~\"$user\",host=~\"$host\"}) == 1",
        "step": "15s",
        "titleFormat": "gaming",
        "textFormat": "gaming session active",
        "tagKeys": "",
        "useValueForTime": false
      }
    ]
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "user",
        "label": "user",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "query": {
          "query": "label_values(molly_up, user)",
          "refId": "user"
        },
        "definition": "label_values(molly_up, user)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "query": {
          "query": "label_values(molly_up{user=~\"$user\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(molly_up{user=~\"$user\"}, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "This week",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Gaming hours",
      "description": "Time with a game frontmost, or a Steam or CrossOver game keeping the GPU busy.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "sum(increase(molly_gaming_platform_seconds_total{user=~\"$user\",host=~\"$host\"}[$__range])) / 3600",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Sessions",
      "description": "Sessions started in the selected range.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "sum(increase(molly_gaming_sessions_total{user=~\"$user\",host=~\"$host\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Longest session",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "max(max_over_time(molly_gaming_session_seconds{user=~\"$user\",host=~\"$host\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Average session",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "sum(increase(molly_gaming_platform_seconds_total{user=~\"$user\",host=~\"$host\"}[$__range])) / clamp_min(sum(increase(molly_gaming_sessions_total{user=~\"$user\",host=~\"$host\"}[$__range])), 1)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Late-night gaming",
      "description": "Gaming between 23:00 and 05:00 local time. The timezone offset is molly:local_utc_offset_hours in molly.yml.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "sum(sum_over_time((molly:gaming_seconds:increase1h{user=~\"$user\",host=~\"$host\"} and on () ((hour() + scalar(molly:local_utc_offset_hours) + 24) % 24 <= 5))[$__range:1h]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#ec835a",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Gaming after a long day",
      "description": "Sessions that started when the previous 24 hours already held more than 8 active hours (5 minute resolution).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "sum(sum_over_time((round(sum by (user, host) (increase(molly_gaming_sessions_total{user=~\"$user\",host=~\"$host\"}[5m]))) and on (user, host) (molly:active_hours:1d{user=~\"$user\",host=~\"$host\"} > 8))[$__range:5m]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Gaming against working",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Gaming vs working hours per day",
      "description": "Each bar is the trailing 24 hours. Gaming is part of active time, so working is active minus gaming.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "clamp_min(sum by (host) (molly:active_hours:1d{user=~\"$user\",host=~\"$host\"}) - sum by (host) (molly:gaming_seconds:increase1d{user=~\"$user\",host=~\"$host\"}) / 3600, 0)",
          "legendFormat": "working {{host}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "sum by (host) (molly:gaming_seconds:increase1d{user=~\"$user\",host=~\"$host\"}) / 3600",
          "legendFormat": "gaming {{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "gradientMode": "none"
          },
          "mappings": [],
          "min": 0,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Late-night gaming per day",
      "description": "Gaming between 23:00 and 05:00 local time in the trailing 24 hours.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "sum by (host) (molly:gaming_late_night_seconds:increase1d{user=~\"$user\",host=~\"$host\"})",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e6bd6"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none"
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Sessions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Session length",
      "description": "Each ramp is one session growing; its peak is the session's length.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "max by (host) (molly_gaming_session_seconds{user=~\"$user\",host=~\"$host\"})",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e6bd6"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none"
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "state-timeline",
      "title": "Gaming session",
      "description": "A bar means a session was open on that platform.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "molly_gaming_active{user=~\"$user\",host=~\"$host\"}",
          "legendFormat": "{{platform}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "no",
                  "color": "#898781",
                  "index": 0
                },
                "1": {
                  "text": "playing",
                  "color": "#8e6bd6",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#898781",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "What you played",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Games by time",
      "description": "Needs the collectors.gaming.games policy; with it off the series are absent and this panel says so.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "topk(10, sum by (game) (increase(molly_gaming_seconds_total{user=~\"$user\",host=~\"$host\"}[$__range])))",
          "legendFormat": "{{game}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e6bd6"
          },
          "min": 0,
          "mappings": [],
          "noValue": "games label disabled (set collectors.gaming.games.enabled to see titles)"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "minVizHeight": 16
      },
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "bargauge",
      "title": "Lifetime Steam playtime",
      "description": "From Steam's localconfig.vdf, updated when a game exits.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "topk(10, molly_gaming_playtime_minutes{user=~\"$user\",host=~\"$host\"})",
          "legendFormat": "{{game}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e6bd6"
          },
          "min": 0,
          "mappings": [],
          "noValue": "games label disabled (set collectors.gaming.games.enabled to see titles)"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
