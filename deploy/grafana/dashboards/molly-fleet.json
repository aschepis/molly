{
  "uid": "molly-fleet",
  "title": "Molly / Fleet",
  "description": "Every machine running Molly, side by side: liveness, activity, cost, scrape health.",
  "tags": [
    "molly"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "user",
        "label": "user",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "query": {
          "query": "label_values(molly_up, user)",
          "refId": "user"
        },
        "definition": "label_values(molly_up, user)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "query": {
          "query": "label_values(molly_up{user=~\"$user\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(molly_up{user=~\"$user\"}, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Hosts",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Hosts",
      "description": "One row per user/host. Collectors failing = enabled collectors with no success in 10 minutes. Host and user are const labels on every Molly series, so each machine stays distinct.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "molly_up{user=~\"$user\",host=~\"$host\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "molly_build_info{user=~\"$user\",host=~\"$host\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "molly_user_active{user=~\"$user\",host=~\"$host\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "label_replace(molly_focus_app{user=~\"$user\",host=~\"$host\"}, \"focused\", \"$1\", \"app\", \"(.*)\")",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "molly_battery_percent{user=~\"$user\",host=~\"$host\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "molly_cpu_utilization_ratio{user=~\"$user\",host=~\"$host\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "molly_memory_pressure_level{user=~\"$user\",host=~\"$host\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "count by (user, host) (molly_collector_enabled{user=~\"$user\",host=~\"$host\"} == 1 and (time() - molly_collector_last_success_timestamp_seconds{user=~\"$user\",host=~\"$host\"}) > 600)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "time() - molly_start_time_seconds{user=~\"$user\",host=~\"$host\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Battery"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Host",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value #B": true,
              "Value #D": true,
              "app": true,
              "bundle_id": true,
              "Time": true,
              "user": true,
              "host": true,
              "job": true,
              "instance": true,
              "__name__": true
            },
            "renameByName": {
              "host": "Host",
              "user": "User",
              "version": "Version",
              "Value #A": "Molly up",
              "Value #C": "Active now",
              "focused": "Focused app",
              "Value #E": "Battery",
              "Value #F": "CPU",
              "Value #G": "Mem pressure",
              "Value #H": "Collectors failing",
              "Value #I": "Uptime"
            }
          }
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Today, per host",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Active hours today",
      "description": "Trailing 24 hours per host.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "sum by (host) (increase(molly_active_seconds_total{user=~\"$user\",host=~\"$host\"}[1d])) / 3600",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none"
          },
          "mappings": [],
          "min": 0,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Commits today",
      "description": "Your commits in the trailing 24 hours per host.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "sum by (host) (increase(molly_git_commits_total{user=~\"$user\",host=~\"$host\",author=\"me\"}[1d]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none"
          },
          "mappings": [],
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Claude list-price equivalent today",
      "description": "Token counts times list prices, not a bill. With collectors.claude_code.pricing.mode set to subscription this is a list-price equivalent (subscription), not spend.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "sum by (host) (increase(molly_claude_estimated_cost_usd_total{user=~\"$user\",host=~\"$host\"}[1d]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#eb6834"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none"
          },
          "mappings": [],
          "min": 0,
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Scrape duration",
      "description": "Built-in series per scrape target; one target per machine in prometheus.yml.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "scrape_duration_seconds{job=\"molly\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none"
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Liveness",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Molly up per host",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "molly_up{user=~\"$user\",host=~\"$host\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#898781"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "#d03b3b",
                  "index": 0
                },
                "1": {
                  "text": "up",
                  "color": "#0ca30c",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    },
    {
      "type": "state-timeline",
      "title": "User active per host",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "molly-prometheus"
          },
          "expr": "molly_user_active{user=~\"$user\",host=~\"$host\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#898781"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle",
                  "color": "#898781",
                  "index": 0
                },
                "1": {
                  "text": "active",
                  "color": "#0ca30c",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "molly-prometheus"
      }
    }
  ]
}
