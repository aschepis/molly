{
  "uid": "molly-week",
  "title": "Molly / Week",
  "description": "Seven-day review: daily shape, week-over-week change, top apps and repos.",
  "tags": [
    "molly"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "name": "Commits",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#2a78d6",
        "expr": "changes(molly_git_last_commit_timestamp_seconds{user=~\"$user\",host=~\"$host\"}[1m]) > 0",
        "step": "15s",
        "titleFormat": "commit",
        "textFormat": "{{repo}}",
        "tagKeys": "repo",
        "useValueForTime": false
      },
      {
        "name": "Meeting",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#eb6834",
        "expr": "molly_meeting_active{user=~\"$user\",host=~\"$host\"} == 1",
        "step": "15s",
        "titleFormat": "meeting",
        "textFormat": "mic or camera in use",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Calendar event",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#1aa3a3",
        "expr": "molly_calendar_in_event{user=~\"$user\",host=~\"$host\"} == 1",
        "step": "15s",
        "titleFormat": "calendar event",
        "textFormat": "inside a timed calendar event",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Claude session",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#8a5cd6",
        "expr": "increase(molly_claude_sessions_total{user=~\"$user\",host=~\"$host\"}[1m]) > 0",
        "step": "15s",
        "titleFormat": "Claude session",
        "textFormat": "new Claude Code session",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Sleep",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#898781",
        "expr": "increase(molly_sleep_events_total{user=~\"$user\",host=~\"$host\"}[1m]) > 0",
        "step": "15s",
        "titleFormat": "sleep",
        "textFormat": "machine went to sleep",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Wake",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#0ca30c",
        "expr": "increase(molly_wake_events_total{user=~\"$user\",host=~\"$host\"}[1m]) > 0",
        "step": "15s",
        "titleFormat": "wake",
        "textFormat": "machine woke",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Locked",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#d6489a",
        "expr": "molly_screen_locked{user=~\"$user\",host=~\"$host\"} == 1",
        "step": "15s",
        "titleFormat": "locked",
        "textFormat": "screen locked",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Rebooted",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#d03b3b",
        "expr": "changes(molly_boot_timestamp_seconds{user=~\"$user\",host=~\"$host\"}[1m]) > 0",
        "step": "15s",
        "titleFormat": "reboot",
        "textFormat": "machine restarted",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Gaming",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#8a5cd6",
        "expr": "max by (user, host) (molly_gaming_active{user=~\"$user\",host=~\"$host\"}) == 1",
        "step": "15s",
        "titleFormat": "gaming",
        "textFormat": "gaming session active",
        "tagKeys": "",
        "useValueForTime": false
      }
    ]
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "user",
        "label": "user",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "query": {
          "query": "label_values(molly_up, user)",
          "refId": "user"
        },
        "definition": "label_values(molly_up, user)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "query": {
          "query": "label_values(molly_up{user=~\"$user\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(molly_up{user=~\"$user\"}, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
