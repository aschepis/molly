    "list": [
      {
        "name": "user",
        "label": "user",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "query": {
          "query": "label_values(molly_up, user)",
          "refId": "user"
        },
        "definition": "label_values(molly_up, user)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
