{
  "uid": "molly-health",
  "title": "Molly / Health",
  "description": "Is Molly running, being scraped, and are its collectors healthy.",
  "tags": [
    "molly"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "name": "Sleep",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#898781",
        "expr": "increase(molly_sleep_events_total{user=~\"$user\",host=~\"$host\"}[1m]) > 0",
        "step": "15s",
        "titleFormat": "sleep",
        "textFormat": "machine went to sleep",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Wake",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#0ca30c",
        "expr": "increase(molly_wake_events_total{user=~\"$user\",host=~\"$host\"}[1m]) > 0",
        "step": "15s",
        "titleFormat": "wake",
        "textFormat": "machine woke",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Locked",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#d6489a",
        "expr": "molly_screen_locked{user=~\"$user\",host=~\"$host\"} == 1",
        "step": "15s",
        "titleFormat": "locked",
        "textFormat": "screen locked",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "name": "Rebooted",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#d03b3b",
        "expr": "changes(molly_boot_timestamp_seconds{user=~\"$user\",host=~\"$host\"}[1m]) > 0",
        "step": "15s",
        "titleFormat": "reboot",
        "textFormat": "machine restarted",
        "tagKeys": "",
        "useValueForTime": false
      }
    ]
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "user",
        "label": "user",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "query": {
          "query": "label_values(molly_up, user)",
          "refId": "user"
        },
        "definition": "label_values(molly_up, user)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "molly-prometheus"
        },
        "query": {
          "query": "label_values(molly_up{user=~\"$user\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(molly_up{user=~\"$user\"}, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
